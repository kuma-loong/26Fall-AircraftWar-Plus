@startuml
' https://plantuml.com/class-diagram

title Aircraft War - Experiment 1 Class Diagram
skinparam classAttributeIconSize 0

package basic {
  abstract class AbstractFlyingObject {
      # locationX:int
      # locationY:int
      # speedX:int
      # speedY:int
      # image:BufferedImage
      # width:int
      # height:int
      # isValid:boolean
      + AbstractFlyingObject(int locationX, int locationY, int speedX, int speedY)
      + forward():void
      + crash(AbstractFlyingObject flyingObject):boolean
      + setLocation(double locationX, double locationY):void
      + getLocationX():int
      + getLocationY():int
      + getSpeedY():int
      + getImage():BufferedImage
      + getWidth():int
      + getHeight():int
      + notValid():boolean
      + vanish():void
  }
}

package bullet {
  abstract class BaseBullet {
      - power:int
      + BaseBullet(int locationX, int locationY, int speedX, int speedY, int power)
      + forward():void
      + getPower():int
  }

  class HeroBullet {
      + HeroBullet(int locationX, int locationY, int speedX, int speedY, int power)
  }

  class EnemyBullet {
      + EnemyBullet(int locationX, int locationY, int speedX, int speedY, int power)
  }
}

package aircraft {
  abstract class AbstractAircraft {
      # maxHp:int
      # hp:int
      - baseShootCycle:int
      - shootCycleFactor:double
      - shootCounter:int
      + AbstractAircraft(int locationX, int locationY, int speedX, int speedY, int hp)
      + decreaseHp(int decrease):void
      + increaseHp(int increase):void
      + getHp():int
      + getMaxHp():int
      + setBaseShootCycle(int baseShootCycle):void
      + setShootCycleFactor(double shootCycleFactor):void
      + canShootNow():boolean
      + {abstract} shoot():List<BaseBullet>
  }

  class HeroAircraft {
      - {static} instance:HeroAircraft
      - shootNum:int
      - power:int
      - direction:int
      - HeroAircraft(int locationX, int locationY, int speedX, int speedY, int hp)
      + {static} getInstance():HeroAircraft
      + forward():void
      + shoot():List<BaseBullet>
  }

  class MobEnemy {
      + MobEnemy(int locationX, int locationY, int speedX, int speedY, int hp)
      + forward():void
      + shoot():List<BaseBullet>
  }

  class EliteEnemy {
      - shootNum:int
      - power:int
      - direction:int
      + EliteEnemy(int locationX, int locationY, int speedX, int speedY, int hp)
      + forward():void
      + shoot():List<BaseBullet>
  }

  class ElitePlusEnemy {
      + ElitePlusEnemy(int locationX, int locationY, int speedX, int speedY, int hp)
      + shoot():List<BaseBullet>
  }

  class AceEnemy {
      + AceEnemy(int locationX, int locationY, int speedX, int speedY, int hp)
      + shoot():List<BaseBullet>
  }

  class BossEnemy {
      + BossEnemy(int locationX, int locationY, int speedX, int speedY, int hp)
      + shoot():List<BaseBullet>
  }
}

package item {
  abstract class AbstractItem {
      + AbstractItem(int locationX, int locationY, int speedX, int speedY)
      + forward():void
      + {abstract} activate(HeroAircraft heroAircraft):void
  }

  class BloodItem {
      - {static} RECOVER_HP:int
      + BloodItem(int locationX, int locationY, int speedX, int speedY)
      + activate(HeroAircraft heroAircraft):void
  }

  class FireItem {
      + FireItem(int locationX, int locationY, int speedX, int speedY)
      + activate(HeroAircraft heroAircraft):void
  }

  class SuperFireItem {
      + SuperFireItem(int locationX, int locationY, int speedX, int speedY)
      + activate(HeroAircraft heroAircraft):void
  }

  class BombItem {
      + BombItem(int locationX, int locationY, int speedX, int speedY)
      + activate(HeroAircraft heroAircraft):void
  }

  class FreezeItem {
      + FreezeItem(int locationX, int locationY, int speedX, int speedY)
      + activate(HeroAircraft heroAircraft):void
  }
}

package application {
  class Game {
      - timer:Timer
      - heroAircraft:HeroAircraft
      - enemyAircrafts:List<AbstractAircraft>
      - heroBullets:List<BaseBullet>
      - enemyBullets:List<BaseBullet>
      - items:List<AbstractItem>
      - shootCycle:double
      - enemyShootCycleFactor:double
      + action():void
      + setEnemyShootCycleFactor(double enemyShootCycleFactor):void
  }
}

AbstractFlyingObject <|-- AbstractAircraft
AbstractFlyingObject <|-- BaseBullet
AbstractFlyingObject <|-- AbstractItem

BaseBullet <|-- HeroBullet
BaseBullet <|-- EnemyBullet

AbstractAircraft <|-- HeroAircraft
AbstractAircraft <|-- MobEnemy
AbstractAircraft <|-- EliteEnemy
AbstractAircraft <|-- ElitePlusEnemy
AbstractAircraft <|-- AceEnemy
AbstractAircraft <|-- BossEnemy

AbstractItem <|-- BloodItem
AbstractItem <|-- FireItem
AbstractItem <|-- SuperFireItem
AbstractItem <|-- BombItem
AbstractItem <|-- FreezeItem

Game ..> HeroAircraft : getInstance()
Game ..> AbstractAircraft : spawn/manage
Game ..> AbstractItem : drop/manage
Game ..> BaseBullet : manage
AbstractItem ..> HeroAircraft : activate()

newpage

title HeroAircraft Singleton (DCL)
skinparam classAttributeIconSize 0

class HeroAircraft {
    - {static} instance:HeroAircraft
    - HeroAircraft(int locationX, int locationY, int speedX, int speedY, int hp)
    + {static} getInstance():HeroAircraft
    + forward():void
    + shoot():List<BaseBullet>
}

class Game {
    - heroAircraft:HeroAircraft
    + action():void
}

Game ..> HeroAircraft : getInstance()
note right of HeroAircraft
DCL steps:
1) if (instance == null)
2) synchronized(HeroAircraft.class)
3) if (instance == null) new HeroAircraft(...)
end note

@enduml
