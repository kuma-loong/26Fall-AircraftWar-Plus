{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check Desktop",
      "type": "shell",
      "command": "bash scripts/check-desktop.sh",
      "problemMatcher": "$javac"
    },
    {
      "label": "Run Game",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source scripts/env.sh && java -cp out/production edu.hitsz.application.Main"
      ],
      "dependsOn": "Check Desktop"
    }
  ]
}
